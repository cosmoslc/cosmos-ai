# ===== ASOSIY (real CRM) Supabase loyiha =====
# Faqat o'qish uchun: teachers_hr, groups, students.
# Dashboard -> Project Settings -> API Keys (Publishable / Secret nomlash;
# eski "anon"/"service_role" 2026 oxirida butunlay o'chadi).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ===== AI Supabase loyiha (ALOHIDA, yangi loyiha) =====
# Haftalik reja, fayllar, lug'at, print navbati, chat tarixi shu yerda.
# supabase/ai_project.sql shu loyihada ishga tushiriladi.
NEXT_PUBLIC_SUPABASE_AI_URL=
NEXT_PUBLIC_SUPABASE_AI_PUBLISHABLE_KEY=

# Ikkala loyihada ham hozircha auth yo'q va RLS "dev_open_all" (hammaga
# ochiq). Auth qo'shilguncha jamoat internetiga chiqarmang.

# ===== Gemini =====
GEMINI_API_KEY=
# Vergul bilan bir nechta model yozish mumkin — birinchisi band/topilmasa,
# kod avtomatik keyingisiga o'tadi.
GEMINI_MODEL=gemini-3.6-flash,gemini-3.5-flash-lite,gemini-2.5-flash
